{
  "name": "jjal-card-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/demo",
    "packages/document-model",
    "packages/policies",
    "packages/renderer",
    "packages/template-kit",
    "packages/persistence",
    "packages/content",
    "packages/image-io",
    "packages/editor-core"
  ],
  "scripts": {
    "dev": "vite apps/demo --host 127.0.0.1 --strictPort",
    "build": "npm run build --workspace @jjal/demo",
    "preview": "vite preview apps/demo --host 127.0.0.1 --strictPort",
    "release:prepare": "node scripts/prepare-vercel-release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:acceptance": "node tools/checks/run-acceptance.mjs",
    "freeze:verify": "node tools/integrity/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
